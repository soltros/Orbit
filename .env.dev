# Dev environment variables for Orbit local testing
# Copy this to .env.dev and adjust if needed.
# Used by docker-compose.dev.yml

# ----------------------------------------------------------------
# Flask
# ----------------------------------------------------------------
SECRET_KEY=dev-secret-key-not-for-production
FLASK_ENV=development
DATABASE_PATH=/app/data/orbit_dev.db

# ----------------------------------------------------------------
# Mock Subsonic server (auto-started in docker-compose.dev.yml)
# ----------------------------------------------------------------
# The mock server is running as a container named orbit-mock-subsonic
SUBSONIC_URL=http://orbit-mock-subsonic:4533
SUBSONIC_USER=dev
SUBSONIC_PASS=dev

# ----------------------------------------------------------------
# LLM Integration
# To test the AI queue mode fill in one of these.
# Leave both blank to use "local" recommendation mode only.
# ----------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Recommendation engine mode: "llm" (requires API key) or "local" (no key needed)
RECOMMENDATION_MODE=local

# Optional: Set to true to download upcoming tracks to a temporary buffer and serve locally 
# instead of holding open constant proxy streams to the Subsonic backend.
ENABLE_LOCAL_BUFFERING=false

# ----------------------------------------------------------------
# Routing (dev = direct Nginx, no Traefik domain tricks needed)
# ----------------------------------------------------------------
DOMAIN_NAME=localhost
