# Flask Configuration
SECRET_KEY=some-highly-secure-random-string
FLASK_ENV=production
DATABASE_PATH=/app/data/orbit.db

# Subsonic / Navidrome connection
# Must be accessible from within the Docker network, or external URL
SUBSONIC_URL=http://navidrome:4000
SUBSONIC_USER=your-navidrome-username
SUBSONIC_PASS=your-navidrome-password

# LLM Integration Settings
# Options: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Reverse Proxy Configuration (Traefik)
DOMAIN_NAME=orbit.localhost
ACME_EMAIL=your-email@example.com
