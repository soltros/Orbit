# Frontend Dev Dockerfile (Vite HMR server — not for production)
# Uses the same Node version as prod but runs `vite dev` instead of building
FROM node:20-alpine

WORKDIR /app

# Copy package files and install deps
COPY package.json package-lock.json ./
RUN npm ci

# Source is bind-mounted from the host in docker-compose.dev.yml
# The CMD will be the Vite dev server

EXPOSE 5173

# --host exposes Vite to the container network (required for Docker access)
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]
